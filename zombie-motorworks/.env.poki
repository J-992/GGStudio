# Loaded by `npm run build:poki` (vite build --mode poki).
#
# This is the whole difference between a CrazyGames build and a Poki one:
# `src/app/platform.ts` picks its SDK off this value, and
# `vite-plugins/platformSdk.ts` puts Poki's loader tag in the document head only
# when it reads `poki`. A build made without it ships the CrazyGames SDK, and
# Poki's inspector correctly reports that it cannot find their integration.
VITE_PLATFORM=poki
