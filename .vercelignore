# The deploy builds one game. Everything below is another project in this
# monorepo, or weight the build never reads.
comfy-zoo/
glb-pipeline/
glb-rigger/
merge-ninja/
saved/
Shared/
Subway/
test-results/

zombie-motorworks/docs/
zombie-motorworks/tests/
zombie-motorworks/unit/
zombie-motorworks/playwright-report/
zombie-motorworks/test-results/
zombie-motorworks/*.mjs
!zombie-motorworks/scripts/*.mjs
zombie-motorworks/necromancer.html
zombie-motorworks/portrait.html

# A .vercelignore replaces .gitignore rather than adding to them, so every
# local-only working directory has to be named here too. Left out, the trailer
# renders alone are 833 MB and the upload times out before the build starts.
zombie-motorworks/trailer/
zombie-motorworks/release/
zombie-motorworks/art-src/
zombie-motorworks/.mobile-shots/
zombie-motorworks/.mob/
zombie-motorworks/dist/
zombie-motorworks/*.zip
